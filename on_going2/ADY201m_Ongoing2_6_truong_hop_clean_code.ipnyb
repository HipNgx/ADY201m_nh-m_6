     "data": {
      "text/plain": "          Priority          Dataset  Features  ... Precision  Recall  F1-score\n0  Recall cao nhất  keep_duplicates        18  ...    0.2659  0.7980    0.3989\n1      F1 cao nhất    no_duplicates        18  ...    0.2989  0.7566    0.4285\n\n[2 rows x 8 columns]",
      "text/html": "<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Priority</th>\n      <th>Dataset</th>\n      <th>Features</th>\n      <th>Model</th>\n      <th>Accuracy</th>\n      <th>Precision</th>\n      <th>Recall</th>\n      <th>F1-score</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>Recall cao nhất</td>\n      <td>keep_duplicates</td>\n      <td>18</td>\n      <td>DecisionTree</td>\n      <td>0.7031</td>\n      <td>0.2659</td>\n      <td>0.7980</td>\n      <td>0.3989</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>F1 cao nhất</td>\n      <td>no_duplicates</td>\n      <td>18</td>\n      <td>RandomForest</td>\n      <td>0.7509</td>\n      <td>0.2989</td>\n      <td>0.7566</td>\n      <td>0.4285</td>\n    </tr>\n  </tbody>\n</table>\n</div>"
