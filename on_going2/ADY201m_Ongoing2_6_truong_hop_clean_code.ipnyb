</td>\n      <td>0.00002</td>\n      <td>1.27892</td>\n      <td>0.25810</td>\n      <td>0.00002</td>\n      <td>0.25810</td>\n      <td>20</td>\n      <td>21</td>\n    </tr>\n    <tr>\n      <th>20</th>\n      <td>Sex</td>\n      <td>0.00589</td>\n      <td>3.24034</td>\n      <td>0.07185</td>\n      <td>1.79784</td>\n      <td>0.17997</td>\n      <td>0.07185</td>\n      <td>0.18897</td>\n      <td>21</td>\n      <td>20</td>\n    </tr>\n  </tbody>\n</table>\n</div>"
