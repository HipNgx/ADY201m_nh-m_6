      "text/html": "<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Diabetes_binary</th>\n      <th>Số dòng</th>\n      <th>Tỷ lệ (%)</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>0</td>\n      <td>103921</td>\n      <td>89.078706</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>1</td>\n      <td>12741</td>\n      <td>10.921294</td>\n    </tr>\n  </tbody>\n</table>\n</div>"
