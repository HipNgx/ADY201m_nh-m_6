      "text/html": "<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>Feature</th>\n      <th>full_21</th>\n      <th>reduced_18</th>\n      <th>reduced_16</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>HighBP</td>\n      <td>Giữ</td>\n      <td>Giữ</td>\n      <td>Giữ</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>HighChol</td>\n      <td>Giữ</td>\n      <td>Giữ</td>\n      <td>Giữ</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>CholCheck</td>\n      <td>Giữ</td>\n      <td>Giữ</td>\n      <td>Bỏ trong giả thuyết đối chiếu</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>BMI</td>\n      <td>Giữ</td>\n      <td>Giữ</td>\n      <td>Giữ</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>Smoker</td>\n      <td>Giữ</td>\n      <td>Giữ</td>\n      <td>Giữ</td>\n    </tr>\n    <tr>\n      <th>5</th>\n      <td>Stroke</td>\n      <td>Giữ</td>\n      <td>Bỏ trong giả thuyết đối chiếu</td>\n      <td>Giữ</td>\n    </tr>\n    <tr>\n      <th>6</th>\n      <td>HeartDiseaseorAttack</td>\n      <td>Giữ</td>\n      <td>Giữ</td>\n      <td>Giữ</td>\n    </tr>\n    <tr>\n      <th>7</th>\n      <td>PhysActivity</td>\n      <td>Giữ</td>\n      <td>Giữ</td>\n      <td>Giữ</td>\n    </tr>\n    <tr>\n      <th>8</th>\n      <td>Fruits</td>\n      <td>Giữ</td>\n      <td>Giữ</td>\n      <td>Bỏ trong giả thuyết đối chiếu</td>\n    </tr>\n    <tr>\n      <th>9</th>\n      <td>Veggies</td>\n      <td>Giữ</td>\n      <td>Giữ</td>\n      <td>Bỏ trong giả thuyết đối chiếu</td>\n    </tr>\n    <tr>\n      <th>10</th>\n      <td>HvyAlcoholConsump</td>\n      <td>Giữ</td>\n      <td>Giữ</td>\n      <td>Giữ</td>\n    </tr>\n    <